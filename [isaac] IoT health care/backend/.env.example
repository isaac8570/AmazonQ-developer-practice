# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Database Configuration (향후 사용)
# DATABASE_URL=postgresql://username:password@localhost:5432/iot_healthcare

# Security Keys (향후 사용)
# JWT_SECRET=your-super-secret-jwt-key
# ENCRYPTION_KEY=your-encryption-key

# External APIs (향후 사용)
# NMAP_PATH=/usr/bin/nmap
# OPENVAS_API_URL=http://localhost:9390

# Logging
LOG_LEVEL=info
